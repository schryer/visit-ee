{
  "kind": "service",
  "bin": "visit-ee",
  "ci": {
    "with": {
      "setup": "make venv node",
      "test": "make functional",
      "shellcheck": "with-secrets bin/visit-ee"
    }
  },
  "protect": {
    "checks": [
      "ci / passed"
    ],
    "tags": false,
    "auto_merge": true
  },
  "site": {
    "check_dir": "_site",
    "pr_build": "npm ci && bin/visit-ee build --out _site --env preview --url https://temp.schryer.eu"
  }
}
