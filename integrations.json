{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.pages",
      "paths": [
        ".github/workflows/deploy.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "jsdelivr.purge",
      "paths": [
        "src/assets/edit.js"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/pr.yml",
        ".github/workflows/main.yml"
      ],
      "mode": "advisory"
    }
  ],
  "own_hosts": [
    "schryer.eu",
    "sustenaut.eu"
  ],
  "exclude": [
    {
      "path": "tests/**",
      "reason": "Fakes and test data"
    },
    {
      "path": "**/*.test.js",
      "reason": "Fakes and test data"
    }
  ]
}
