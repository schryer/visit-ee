{#- The places around a site, as a list that works on its own. The shared
    visit.ee map (src/assets/map.js) draws the same places on a map of the
    area and adds the modes and filters, which stay hidden without it. -#}
{%- set icons = {
  nature: '<path d="M12 3l-5 7h3l-4 6h12l-4-6h3z"/><path d="M12 16v5"/>',
  lake: '<path d="M3 10c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M3 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>',
  heritage: '<path d="M4 20h16"/><path d="M6 20v-8l6-6 6 6v8"/><path d="M10 20v-5h4v5"/>',
  museum: '<path d="M3 9l9-5 9 5"/><path d="M5 9v9M10 9v9M14 9v9M19 9v9"/><path d="M3 20h18"/>',
  viewpoint: '<path d="M9 21l2-15h2l2 15"/><path d="M8 6h8l-1-3H9z"/><path d="M10 13h4"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><path d="M12 7.5v.01"/>',
  food: '<path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M9 3v3M12 3v3"/>',
  shop: '<path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>'
} -%}
<section class="wrap section" id="nearby" aria-labelledby="nearby-title">
<h2 id="nearby-title">{{ p.t("nearby.title") }}</h2>
<div class="nearby" data-visit-map>
<script type="application/json" data-map-config>{{ p.mapConfig | json | safe }}</script>
<div class="nearby__map" hidden>
<div class="nearby__canvas" role="region" aria-label="{{ p.t('map.label') }}"></div>
<div class="nearby__tip" hidden></div>
</div>
<div class="nearby__side">
<div class="nearby__controls" hidden>
<div class="nearby__modes" role="group" aria-label="{{ p.t('map.modes') }}">
<button type="button" class="pill" data-mode="foot" aria-pressed="false">{{ p.t("map.foot") }}</button>
<button type="button" class="pill" data-mode="car" aria-pressed="true">{{ p.t("map.car") }}</button>
<details class="nearby__layers">
<summary class="pill">{{ p.t("map.layers") }}</summary>
<div class="nearby__layerbox">
{%- for layer in ["roads", "trails", "buildings", "rings", "borders"] %}
<label><input type="checkbox" data-layer="{{ layer }}" checked> {{ p.t("map.layer." + layer) }}</label>
{%- endfor %}
</div>
</details>
</div>
<div class="nearby__chips" role="group" aria-label="{{ p.t('map.categories') }}">
{%- for cat in p.nearbyCategories %}
<button type="button" class="chip cat-{{ cat.id }}" data-cat="{{ cat.id }}" aria-pressed="true">{{ p.t("cat." + cat.id + ".many") }} <span class="chip__n">{{ cat.count }}</span></button>
{%- endfor %}
</div>
<p class="nearby__count" aria-live="polite"></p>
</div>
<ul class="nearby__list">
{%- asyncEach place in p.nearby %}
<li id="{{ place.id }}" class="place cat-{{ place.category }}" data-place data-cat="{{ place.category }}" data-lat="{{ place.geo.lat }}" data-lng="{{ place.geo.lng }}" data-foot="{{ place.onFoot }}">
<span class="place__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ icons[place.category] | safe }}</svg></span>
<a class="place__name" href="#{{ place.id }}"{% if p.lang != "et" %} lang="et"{% endif %}>{{ place.name }}</a>
{%- if place.description %}
<span class="place__gloss">{{ place.description }}</span>
{%- endif %}
<span class="place__meta"><b>{{ place.distance }}</b> · {{ p.t("cat." + place.category) }}</span>
{#- What the map's place card shows when it opens up: a photo and where to read more. #}
<template class="place__more">
{%- if place.photo %}
{% picture place.photo.owner, place.photo.src, place.name, "(min-width: 60rem) 40rem, 100vw", { widths: [480, 800, 1200], class: "more__img" } %}
{%- endif %}
{%- if place.link and place.link.external %}
<a class="more__link" href="{{ place.link.href }}" target="_blank" rel="noopener"><span>{{ p.t("map.website") }}: {{ place.link.host }}</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg><span class="more__note">({{ p.t("map.new_tab") }})</span></a>
{%- elif place.link %}
<a class="more__link" href="{{ place.link.href }}">{{ p.t("map.page") }} →</a>
{%- endif %}
</template>
</li>
{%- endeach %}
</ul>
</div>
</div>
<script type="module" src="/assets/map.js"></script>
</section>
